{
  "name": "fp-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test:e2e": "npm run test:e2e:app && npm run test:e2e:core && npm run test:e2e:100:desktop && npm run test:e2e:100:mobile",
    "test:e2e:app": "playwright test e2e/app.spec.ts",
    "test:e2e:core": "playwright test e2e/learning.spec.ts -g \"five-question|calculation accepts|glossary search|keyboard shortcuts\"",
    "test:e2e:100:desktop": "playwright test e2e/learning.spec.ts -g \"one hundred questions\" --project=desktop-chromium",
    "test:e2e:100:mobile": "playwright test e2e/learning.spec.ts -g \"one hundred questions\" --project=mobile-chromium"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
